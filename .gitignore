# Design notes and scratch work, kept local.
.agent/

# Dependencies. pi supplies `@earendil-works/*` and bunfig.toml skips installing
# them, so a lockfile would mostly record a peer tree that is never installed.
node_modules/
bun.lock
bun.lockb
package-lock.json
pnpm-lock.yaml
yarn.lock

# Local secrets. Credentials belong in ~/.pi/agent, never in this tree.
.env
.env.*

# Publish artifacts.
*.tgz

# Editor and OS droppings.
.DS_Store
*.swp
.idea/
.vscode/
