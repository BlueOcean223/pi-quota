{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2023", "dom"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["bun"]
	},
	"include": ["*.ts", "sources/*.ts"],
	"exclude": ["node_modules", ".agent"]
}
